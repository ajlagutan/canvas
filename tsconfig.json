{
  "compilerOptions": {
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "module": "commonjs",
    "paths": {
      "@/*": ["src/*"],
      "@/app": ["src/scripts/app"],
      "@/core": ["src/scripts/core"],
      "@/core/ext": ["src/scripts/core/extensions"],
      "@/infra": ["src/scripts/infra"],
      "@/scenes": ["src/scripts/scenes"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2017"
  }
}
